include("lib/socket.bzg");

if (socket_init() < 0) {
    print("Socket Initialization Failed\n");
} else {
    print("Socket Ready\n");
}

var server = socket_create();
if (server < 0) {
    print("Socket Creation Failed\n");
}

if (socket_bind(server, 0, 3000) < 0) {
    print("Socket Bind Failed.\n");
}

if (socket_listen(server, 5) < 0) {
    print("socket_listen() Failed.\n");
}

print("Server running on http://localhost:3000/\n");

// Returns 1 if str ends with suffix, 0 otherwise. Used instead of a
// regex "$"-anchored extension match: the original http.bzg only ever
// used a plain "/.* HTTP/1.1" pattern, and it turns out BSL's regex()
// does not support the "\.[a-zA-Z0-9]+$" character-class/anchor syntax
// the same way -- it silently failed to match, so every static asset was
// falling through to the application/octet-stream default below and the
// browser refused to load game.js as a module. Plain substr comparison
// sidesteps that entirely.
function endsWith(str, suffix) {
    var strLen = sizeof(str);
    var sufLen = sizeof(suffix);
    if (sufLen > strLen) { return 0; }
    if (substr(str, strLen - sufLen, sufLen) == suffix) { return 1; }
    return 0;
}

// ── MIME type lookup ──
// Maps a file's extension to the Content-Type header the browser needs to
// treat it correctly (render an image, play audio/video, execute a JS
// module, parse a glTF binary, etc). Falls back to a generic binary type
// for anything unrecognized rather than refusing the request.
function getContentType(path) {
    if (endsWith(path, ".html")) { return "text/html"; }
    else if (endsWith(path, ".js")) { return "text/javascript"; }
    else if (endsWith(path, ".css")) { return "text/css"; }
    else if (endsWith(path, ".json")) { return "application/json"; }
    else if (endsWith(path, ".svg")) { return "image/svg+xml"; }
    else if (endsWith(path, ".png")) { return "image/png"; }
    else if (endsWith(path, ".jpg")) { return "image/jpeg"; }
    else if (endsWith(path, ".jpeg")) { return "image/jpeg"; }
    else if (endsWith(path, ".mp3")) { return "audio/mpeg"; }
    else if (endsWith(path, ".mp4")) { return "video/mp4"; }
    else if (endsWith(path, ".glb")) { return "model/gltf-binary"; }
    // Base64-encoded sidecar files (see scripts/encode-assets.bat and
    // public/modules/binaryAssetLoader.js). Plain ASCII text, so this is
    // the one binary-adjacent asset type that's actually safe to serve
    // through readFile()/socket_write() as-is -- no embedded 0x00 bytes,
    // so no truncation risk regardless of the underlying file's size.
    else if (endsWith(path, ".b64")) { return "text/plain"; }
    else { return "application/octet-stream"; }
}

// Returns 1 if str contains ".." anywhere, 0 otherwise. Same reasoning as
// endsWith() above: avoids relying on regex("\\.\\.", ...) escaping
// behaving the way it would in a typical PCRE/POSIX engine, since that
// assumption already proved wrong once for the extension match.
function containsDotDot(str) {
    var len = sizeof(str);
    var i;
    for (i = 0; i <= len - 2; i++) {
        if (substr(str, i, 2) == "..") {
            return 1;
        }
    }
    return 0;
}

// Only paths under these prefixes are served as static files. This is a
// deliberate whitelist (rather than "serve whatever public/+path resolves
// to") so a request path can't traverse out of public/ with "../" and
// read arbitrary files off disk.
function isStaticAsset(path) {
    if (substr(path, 0, 8) == "/assets/") { return 1; }
    else if (substr(path, 0, 9) == "/modules/") { return 1; }
    else if (path == "/game.js") { return 1; }
    else if (path == "/about.js") { return 1; }
    else if (path == "/style.css") { return 1; }
    else { return 0; }
}

while (1) {
    var client = socket_accept(server);
    print("Client connected!\n");

    var data = socket_read(client, 1024);

    if (sizeof(data) >= 0) {
        var match = regex("/.* HTTP/1.1", data);
        var path = substr(match, 0, sizeof(match) - 9);
        print("File Requested: " + path);

        // Belt-and-suspenders traversal guard on top of isStaticAsset()'s
        // prefix whitelist below.
        if (containsDotDot(path)) {
            path = "/__blocked__";
        }

        if (path == "/") {
            var HTTP =  "HTTP/1.1 302 Found\r\n"
                        +"Location: /home\r\n"
                        +"Content-Length: 0\r\n"
                        +"Connection: close\r\n"
                        +"\r\n";

            socket_write(client, HTTP, sizeof(HTTP));
            socket_close(client);
            gc();
        }

        else {
            var status = "200 OK";
            var filePath = "";
            var contentType = "text/html";

            if (path == "/home") {
                filePath = "public/index.html";
            }
            else if (path == "/about") {
                filePath = "public/about.html";
            }
            else if (isStaticAsset(path)) {
                // e.g. "/modules/sky.js" -> "public/modules/sky.js"
                filePath = "public" + path;
                contentType = getContentType(filePath);
            }
            else {
                filePath = "public/404.html";
                status = "404 Not Found";
            }

            // fileSize() (not sizeof() on the read buffer) drives
            // Content-Length and the socket_write byte count. This
            // matters for text files (js/css/html/b64) where fileSize()
            // and sizeof(readFile(...)) always agree anyway.
            //
            // CONFIRMED (src/diagnose-binary.bzg): readFile() truncates
            // binary files at their first embedded 0x00 byte -- BSL
            // strings are null-terminated internally, and there is no
            // binary-safe read primitive in the stdlib to fall back on.
            // A 12,935-byte .mp3 came back as 4 bytes. socket_write() is
            // NOT the problem; by the time BODY is built, the data is
            // already gone.
            //
            // Consequence: raw binary assets (.mp3/.mp4/.glb/.png) must
            // never be requested directly through this server -- they'll
            // silently truncate and the browser will throw
            // ERR_CONTENT_LENGTH_MISMATCH or hand a corrupt buffer to
            // whatever tried to parse it. Instead, every binary asset
            // ships as a base64-encoded ".ext.b64" sidecar file (see
            // scripts/encode-assets.bat), which is pure ASCII text with
            // no embedded nulls and round-trips through readFile()/
            // socket_write() intact regardless of size. The client
            // fetches the .b64 file and decodes it back to bytes -- see
            // public/modules/binaryAssetLoader.js.
            var missing = 0;
            if (filePath != "public/404.html") {
                var checkSize = fileSize(filePath);
                if (checkSize < 0) {
                    missing = 1;
                }
            }

            if (missing == 1) {
                filePath = "public/404.html";
                status = "404 Not Found";
                contentType = "text/html";
            }

            var BODY = readFile(filePath);
            var contentLength = fileSize(filePath);

            var HTTP =  "HTTP/1.1 " + status + "\r\n"
                        +"Content-Type: " + contentType + "\r\n"
                        +"Content-Length: "+ contentLength +"\r\n"
                        +"Connection: close\r\n"
                        +"\r\n";

            // Headers and body are written separately (rather than
            // concatenated into one HTTP+BODY string like the original
            // three-route version did) so a binary BODY containing 0x00
            // bytes can't corrupt string concatenation/length math on the
            // header line.
            socket_write(client, HTTP, sizeof(HTTP));
            socket_write(client, BODY, contentLength);
            socket_close(client);
            gc();
        }

    }
}

socket_cleanup();
